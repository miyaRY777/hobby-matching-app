<% badge = room_type_badge(room.room_type) %>
<% creator_name = room.issuer_profile.user.display_name %>
<% issued = issued_room_ids.include?(room.id) %>
<% joined = joined_room_ids.include?(room.id) %>
<% room_label = room.label.presence || "名無しの部屋" %>
<% status_badge = membership_status_badge(issued:, joined:) %>
<% action_label = (issued || joined) ? "入室" : "見学" %>

<tr id="<%= dom_id(room) %>" style="border-bottom: 1px solid rgba(55, 65, 81, 0.25);">
  <td style="padding: 1rem 1.25rem; vertical-align: middle;">
    <div style="font-size: 0.9375rem; font-weight: 600; color: #ffffff;">
      <%= room_label %>
    </div>
  </td>

  <td style="padding: 1rem 1.25rem; vertical-align: middle;">
    <% if badge %>
      <span style="<%= room_badge_pill_style(badge) %>">
        <%= badge[:label] %>
      </span>
    <% end %>
  </td>

  <td style="padding: 1rem 1.25rem; vertical-align: middle; font-size: 0.875rem; color: #d1d5db;">
    <%= room.room_memberships_count %> 人
  </td>

  <td style="padding: 1rem 1.25rem; vertical-align: middle; font-size: 0.875rem; color: #d1d5db;">
    <%= creator_name %>
  </td>

  <td style="padding: 1rem 1.25rem; vertical-align: middle;">
    <span style="<%= room_badge_pill_style(status_badge) %>">
      <%= status_badge[:label] %>
    </span>
  </td>

  <td style="padding: 1rem 1.25rem; vertical-align: middle;">
    <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;">
      <%= link_to action_label,
                  room_path(room),
                  style: room_action_badge_style((issued || joined) ? :enter : :peek, issued:) %>
      <% unless issued || joined %>
        <% if viewer_profile %>
          <%= form_with url: mypage_room_memberships_path, method: :post, style: "margin: 0;" do |f| %>
            <%= f.hidden_field :room_id, value: room.id %>
            <%= f.submit "参加する", style: room_action_badge_style(:join) %>
          <% end %>
        <% else %>
          <%= link_to "参加する", new_mypage_profile_path, style: room_action_badge_style(:join) %>
        <% end %>
      <% end %>
    </div>
  </td>
</tr>
