<turbo-frame id="member_detail">
  <div style="display: flex; min-height: 100%; flex-direction: column; gap: 1rem;">
    <p style="font-size: 0.875rem; font-weight: 700; color: #e2e8f0;">
      <%= @parent_tag.name %>に関連するユーザー <%= @profiles.total_count %>人
    </p>

    <% if @profile %>
      <%= render "rooms/members/card", profile: @profile, room_related_phs: @room_related_phs %>
      <%= paginate @profiles if @profiles.total_pages > 1 %>
    <% else %>
      <p style="color: #94a3b8;">該当するユーザーはいません</p>
    <% end %>
  </div>
</turbo-frame>
